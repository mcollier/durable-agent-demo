{
  "inputs": [
    {
      "type": "promptString",
      "id": "context7-key",
      "description": "Context7 API Key",
      "password": true
    }
  ],
  "mcpServers": {
    "squad_state": {
      "command": "npx",
      "args": [
        "-y",
        "@bradygaster/squad-cli@0.11.0",
        "state-mcp"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${input:context7-key}"
      }
    }
  }
}
